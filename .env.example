# ==============================================================================
# Border Document Screening Platform — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Border Document Screening Platform"
DEBUG=true
LOG_LEVEL=INFO
# Secret key for token signing and session management (replace in production)
SECRET_KEY=insecure-dev-secret-key-replace-in-production-min-32-chars

# ------------------------------------------------------------------------------
# Backend Service (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Service (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Base URL consumed by the officer dashboard to reach the backend REST API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=screening_admin
POSTGRES_PASSWORD=screening_dev_password
POSTGRES_DB=border_screening
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://screening_admin:screening_dev_password@localhost:5432/border_screening

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3-Compatible Storage)
# ------------------------------------------------------------------------------
# Supported providers: minio, s3, local
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCUMENTS=screening-documents
STORAGE_SECURE=false

# ------------------------------------------------------------------------------
# Screening & Verification Thresholds (Defaults)
# ------------------------------------------------------------------------------
# Face similarity decision threshold (cosine similarity range 0.0 to 1.0)
FACE_SIMILARITY_THRESHOLD=0.75
# Minimum required document image resolution (DPI)
MIN_IMAGE_DPI=300
# External document registry provider adapter (mock / authorized)
EXTERNAL_REGISTRY_PROVIDER=mock
